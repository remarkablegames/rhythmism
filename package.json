{
  "name": "rhythmism",
  "private": true,
  "version": "1.3.3",
  "scripts": {
    "build": "npm run clean && vite build",
    "bundle": "bash scripts/bundle.sh",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --project tsconfig.app.json",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite --open"
  },
  "dependencies": {
    "kaboom": "3000.1.17"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "easytimer.js": "4.6.0",
    "eslint": "10.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-html": "3.2.2"
  }
}
